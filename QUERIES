WITH Q28 AS (
    SELECT DISTINCT 
        provider_id,
        CREATED_BY,
        CASE 
            WHEN module_key = 'Objective criteria - Bangalore' THEN
                CASE answer
                    WHEN 'QQ1' THEN 'Foundational Cohort'
                    WHEN 'QQ2' THEN 'language Cohort'
                    WHEN 'QQ3' THEN 'No Cohort'
                END
            WHEN module_key = 'Objective criteria delhi' THEN
                CASE answer
                    WHEN 'QQ1' THEN 'Foundational Cohort'
                    WHEN 'QQ2' THEN 'No Cohort'
                    WHEN 'QQ3' THEN 'No Cohort'
                END
            ELSE
                CASE answer
                    WHEN 'QQ1' THEN 'Foundational Cohort'
                    WHEN 'QQ2' THEN 'language Cohort'
                    WHEN 'QQ3' THEN 'No Cohort'
                END
        END AS response,
        ROW_NUMBER() OVER (PARTITION BY provider_id ORDER BY created_at_ist DESC) AS rn
    FROM PROVIDER_MODULE_PROVIDER_RESPONSE__VIEW
    WHERE customer_category_key = 'insta_maids'
      AND module_type = 'screening'
      AND statement ILIKE '%Cohort%'
    QUALIFY rn = 1
),

pip_base AS (
    SELECT 
        provider_id,
        DATE_TRUNC('week', approval_date) AS app_week,
        CITY,
        tier,
        tier_start_date,
        tier_end_date,
        paf_cancellation_at_tier AS paf_error,
        rating_error_at_tier AS rating_error,
        graded_leave_days_at_tier AS total_graded_leaves,
        ROW_NUMBER() OVER (
            PARTITION BY provider_id 
            ORDER BY DATE(tier_start_date)
        ) AS cycle_no
    FROM provider_promise_plan__daily__metrics
    WHERE category = 'instant_maids_l3'
      AND tier IS NOT NULL
),

tier_status AS (
    SELECT
        provider_id,
        city,
        app_week,
        cycle_no,
        CASE
            WHEN rating_error < 4 AND paf_error < 4 AND total_graded_leaves = 0 THEN 'diamond'
            WHEN rating_error < 4 AND paf_error < 4 AND total_graded_leaves = 1 THEN 'gold'
            WHEN rating_error < 4 AND paf_error < 4 AND total_graded_leaves = 2 THEN 'silver'
            WHEN rating_error < 4 AND paf_error < 4 AND total_graded_leaves BETWEEN 3 AND 4 THEN 'bronze'
            ELSE 'pip'
        END AS potential_tier,
        CASE WHEN tier_end_date <= CURRENT_DATE THEN 1 ELSE 0 END AS completion_flag
    FROM pip_base
),

tier_final AS (
    SELECT
        provider_id,
        city,
        app_week,
        MAX(CASE 
                WHEN cycle_no = 1 AND completion_flag = 1 
                THEN potential_tier 
            END) AS c1_tier,
        MAX(CASE 
                WHEN cycle_no = 2 AND completion_flag = 1 
                THEN potential_tier 
            END) AS c2_tier
    FROM tier_status
    GROUP BY provider_id, city, app_week
),

-- L7D (Last 7 Days) status to determine if provider is Active or Churned
l7d AS (
    SELECT 
        pdf.provider_id, 
        pdf.last_delivery_date,
        pdf.approval_date,
        CASE 
            WHEN SUM(CASE WHEN acm.status = 'marked working' THEN 1 ELSE 0 END) > 8 THEN 'Working'
            ELSE 'Not Working'
        END AS L7D_status
    FROM provider__daily__facts pdf
    LEFT JOIN PUBLIC.providerXdateXhour__calendar_marking__hourly__facts acm
        ON pdf.provider_id = acm.provider_id
        AND DATE(acm.date) BETWEEN CURRENT_DATE - 6 AND CURRENT_DATE
        AND acm.start_hour_local BETWEEN 8 AND 19
    WHERE pdf.customer_category_key = 'insta_maids'
      AND pdf.provider_name NOT ILIKE '%test%'
      AND pdf.approval_date IS NOT NULL
    GROUP BY pdf.provider_id, pdf.last_delivery_date, pdf.approval_date
)

SELECT 
    q.provider_id,
    tf.city AS "CITY::multi-filter",
    tf.app_week AS "app_week::multi-filter",
    q.response AS "Cohort",
    tf.c1_tier,
    tf.c2_tier,
    CASE   
        WHEN COALESCE(l7d.L7D_status, 'Unknown') = 'Not Working' THEN 'Churn'
        WHEN COALESCE(l7d.L7D_status, 'Unknown') = 'Working' THEN 'Active'
        WHEN l7d.last_delivery_date IS NULL AND DATE(l7d.approval_date) >= CURRENT_DATE - 7 THEN 'Active'
        ELSE 'Churn'
    END AS churn_status
FROM Q28 q 
LEFT JOIN tier_final tf ON q.provider_id = tf.provider_id
LEFT JOIN l7d ON q.provider_id = l7d.provider_id
WHERE tf.c1_tier IS NOT NULL 
  AND tf.c2_tier IS NOT NULL;
