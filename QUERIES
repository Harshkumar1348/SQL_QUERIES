6) RFM SEGMENTATION (Recency, Frequency, Monetary)
============================================================
-- RFM scores (1-5) by quintiles; adapt NTILE support per DB.
WITH paid_orders AS (
  SELECT
    <customer_id_col> AS customer_id,
    CAST(<order_ts_col> AS DATE) AS order_date,
    <total_col> AS order_total
  FROM <orders_table>
  WHERE <status_col> IN ('paid', 'completed')
),
agg AS (
  SELECT
    customer_id,
    MAX(order_date) AS last_order_date,
    COUNT(*) AS frequency,
    SUM(order_total) AS monetary
  FROM paid_orders
  GROUP BY 1
),
scored AS (
  SELECT
    a.*,
    (CURRENT_DATE - a.last_order_date) AS recency_days,
    NTILE(5) OVER (ORDER BY (CURRENT_DATE - a.last_order_date) ASC) AS r_score, -- lower recency_days = better
    NTILE(5) OVER (ORDER BY a.frequency DESC) AS f_score,
    NTILE(5) OVER (ORDER BY a.monetary DESC) AS m_score
  FROM agg a
)
SELECT
  customer_id,
  recency_days,
  frequency,
  monetary,
  r_score, f_score, m_score,
  (r_score * 100 + f_score * 10 + m_score) AS rfm_code
FROM scored
ORDER BY rfm_code DESC;

