9) DATA QUALITY CHECKS (high value in real businesses)
============================================================
-- Duplicate order IDs
SELECT <order_id_col>, COUNT(*) AS cnt
FROM <orders_table>
GROUP BY 1
HAVING COUNT(*) > 1
ORDER BY cnt DESC;

-- Negative totals / suspicious values
SELECT *
FROM <orders_table>
WHERE <total_col> < 0
   OR <subtotal_col> < 0
   OR <tax_col> < 0
   OR <shipping_col> < 0;

-- Orphan line items (line without matching order)
SELECT oi.*
FROM <order_items_table> oi
LEFT JOIN <orders_table> o ON o.<order_id_col> = oi.<order_id_col>
WHERE o.<order_id_col> IS NULL;

