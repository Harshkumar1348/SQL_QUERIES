7) PROFITABILITY (needs product cost)
============================================================
-- Gross margin by product/category in last 90 days
WITH recent_paid_orders AS (
  SELECT <order_id_col> AS order_id
  FROM <orders_table>
  WHERE <status_col> IN ('paid', 'completed')
    AND <order_ts_col> >= CURRENT_DATE - INTERVAL '90 day'
),
lines AS (
  SELECT
    oi.<product_id_col> AS product_id,
    SUM(oi.<qty_col>) AS units,
    SUM(oi.<line_total_col>) AS revenue
  FROM <order_items_table> oi
  JOIN recent_paid_orders o ON o.order_id = oi.<order_id_col>
  GROUP BY 1
)
SELECT
  l.product_id,
  p.<category_col> AS category,
  l.units,
  l.revenue,
  (p.<cost_col> * l.units) AS cogs,
  (l.revenue - (p.<cost_col> * l.units)) AS gross_profit,
  (l.revenue - (p.<cost_col> * l.units)) * 1.0 / NULLIF(l.revenue, 0) AS gross_margin
FROM lines l
JOIN <products_table> p ON p.<product_id_col> = l.product_id
ORDER BY gross_profit DESC;

