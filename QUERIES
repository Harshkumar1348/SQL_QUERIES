8) INVENTORY: STOCKOUT RISK & AGING
============================================================
-- Requires inventory snapshot:
-- <inventory_table>(<product_id_col>, <snapshot_date_col>, <on_hand_col>, <on_order_col>, <reorder_point_col>)
SELECT
  i.<snapshot_date_col> AS snapshot_date,
  i.<product_id_col> AS product_id,
  i.<on_hand_col> AS on_hand,
  i.<on_order_col> AS on_order,
  i.<reorder_point_col> AS reorder_point,
  CASE WHEN i.<on_hand_col> <= i.<reorder_point_col> THEN 1 ELSE 0 END AS below_reorder_point
FROM <inventory_table> i
WHERE i.<snapshot_date_col> = (SELECT MAX(<snapshot_date_col>) FROM <inventory_table>)
ORDER BY below_reorder_point DESC, on_hand ASC;

