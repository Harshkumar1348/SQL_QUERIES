5) FUNNELS (web/app events → conversion)
============================================================
-- Requires events table:
-- <events_table>(<user_id_col>, <event_ts_col>, <event_name_col>, <session_id_col>, <properties_json_col>...)
-- Example: session-level funnel (visit → add_to_cart → checkout → purchase)
WITH sessions AS (
  SELECT
    <session_id_col> AS session_id,
    MIN(<event_ts_col>) AS session_start
  FROM <events_table>
  WHERE <event_ts_col> >= CURRENT_DATE - INTERVAL '30 day'
  GROUP BY 1
),
flags AS (
  SELECT
    e.<session_id_col> AS session_id,
    MAX(CASE WHEN e.<event_name_col> = 'visit' THEN 1 ELSE 0 END) AS did_visit,
    MAX(CASE WHEN e.<event_name_col> = 'add_to_cart' THEN 1 ELSE 0 END) AS did_add_to_cart,
    MAX(CASE WHEN e.<event_name_col> = 'checkout' THEN 1 ELSE 0 END) AS did_checkout,
    MAX(CASE WHEN e.<event_name_col> = 'purchase' THEN 1 ELSE 0 END) AS did_purchase
  FROM <events_table> e
  JOIN sessions s ON s.session_id = e.<session_id_col>
  GROUP BY 1
)
SELECT
  COUNT(*) AS sessions,
  SUM(did_visit) AS visits,
  SUM(did_add_to_cart) AS add_to_cart,
  SUM(did_checkout) AS checkout,
  SUM(did_purchase) AS purchase,
  SUM(did_purchase) * 1.0 / NULLIF(SUM(did_visit), 0) AS visit_to_purchase_rate
FROM flags;

