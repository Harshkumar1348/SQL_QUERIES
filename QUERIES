10) “MOST COMMON COMPLEX SQL TRICKS” CHEATSHEET
============================================================
-- A) Window functions: running totals
SELECT
  CAST(<order_ts_col> AS DATE) AS order_date,
  SUM(<total_col>) AS daily_revenue,
  SUM(SUM(<total_col>)) OVER (ORDER BY CAST(<order_ts_col> AS DATE)) AS running_revenue
FROM <orders_table>
WHERE <status_col> IN ('paid', 'completed')
GROUP BY 1
ORDER BY 1;

-- B) Top-N per group (e.g., top 3 products per category)
WITH prod_rev AS (
  SELECT
    p.<category_col> AS category,
    oi.<product_id_col> AS product_id,
    SUM(oi.<line_total_col>) AS revenue
  FROM <order_items_table> oi
  JOIN <orders_table> o ON o.<order_id_col> = oi.<order_id_col>
  JOIN <products_table> p ON p.<product_id_col> = oi.<product_id_col>
  WHERE o.<status_col> IN ('paid', 'completed')
  GROUP BY 1,2
),
ranked AS (
  SELECT
    *,
    ROW_NUMBER() OVER (PARTITION BY category ORDER BY revenue DESC) AS rn
  FROM prod_rev
)
SELECT category, product_id, revenue
FROM ranked
WHERE rn <= 3
ORDER BY category, revenue DESC;

