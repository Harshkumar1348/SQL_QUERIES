-- Query to identify partners with consecutive leaves (2+ days)
-- Fixed to properly detect ANY consecutive absence pattern

WITH approved_partners AS (
  SELECT DISTINCT provider_id
  FROM provider__daily__facts
  WHERE customer_category_key = 'insta_maids'
    AND approval_date <= CURRENT_DATE
    AND country = 'India'
),

base AS (
    SELECT DISTINCT 
        b.provider_id,
        b.provider_name,
        b.city,
        DATE(b.approval_Date) AS ad,
        DATEDIFF(day, DATE(b.approval_Date), CURRENT_DATE) AS age_days
    FROM provider_master b
    INNER JOIN approved_partners ap ON b.provider_id = ap.provider_id
    WHERE b.customer_category_key = 'insta_maids' 
      AND b.approval_Date IS NOT NULL
      AND b.city = 'Bangalore'
      AND b.provider_name NOT LIKE '%Test%'
),

hubs AS (
    SELECT * 
    FROM PROVIDERXPRIMARY_HUBXDATE__DAILY__FACTS
    WHERE provider_id IN (SELECT DISTINCT provider_id FROM base)
      AND updated_at = CURRENT_DATE
),

temp_block AS (
    SELECT DISTINCT
        p.provider_id,
        p.temporary_block,
        COALESCE(t.value:reason::STRING, 'None') AS temp_block_reason,
        TRY_TO_TIMESTAMP(REGEXP_SUBSTR(COALESCE(t.value:created_at::STRING, '0'), '[0-9]+')) AS temp_block_date
    FROM public.provider_master p,
         LATERAL FLATTEN(input => TRY_PARSE_JSON(p.temporary_block_reasons)) AS t
    WHERE p.provider_id IN (SELECT provider_id FROM base)
      AND t.value IS NOT NULL
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY p.provider_id 
        ORDER BY temp_block_date DESC NULLS LAST
    ) = 1
),

-- Generate date series for last 7 days
date_series AS (
    SELECT DATEADD(day, -seq.seq, CURRENT_DATE) AS date_value
    FROM (
        SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) - 1 AS seq
        FROM TABLE(GENERATOR(ROWCOUNT => 8))
    ) seq
    WHERE seq.seq BETWEEN 0 AND 7
),

-- Create cartesian product of providers and dates
provider_dates AS (
    SELECT 
        b.provider_id,
        ds.date_value
    FROM base b
    CROSS JOIN date_series ds
),

-- Identify which dates each provider was present
provider_attendance_raw AS (
    SELECT 
        p.provider_id,
        DATE(p.date) AS attendance_date
    FROM providerxdate__active_profile__hourly__facts p
    JOIN base b ON p.provider_id = b.provider_id
    WHERE DATE(p.date) BETWEEN CURRENT_DATE - 7 AND CURRENT_DATE
      AND UPPER(p.ischeckedin::text) IN ('1','TRUE','YES')
    GROUP BY p.provider_id, DATE(p.date)
),

-- Mark each date as present (1) or absent (0)
provider_daily_status AS (
    SELECT 
        pd.provider_id,
        pd.date_value,
        CASE WHEN par.attendance_date IS NOT NULL THEN 1 ELSE 0 END AS is_present
    FROM provider_dates pd
    LEFT JOIN provider_attendance_raw par 
        ON pd.provider_id = par.provider_id 
        AND pd.date_value = par.attendance_date
),

-- Identify consecutive absence groups using window functions
consecutive_absences AS (
    SELECT 
        provider_id,
        date_value,
        is_present,
        -- Create a group identifier for consecutive absences
        SUM(is_present) OVER (
            PARTITION BY provider_id 
            ORDER BY date_value 
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ) AS attendance_group
    FROM provider_daily_status
),

-- Count consecutive absence days per group
consecutive_leave_counts AS (
    SELECT 
        provider_id,
        attendance_group,
        COUNT(*) AS consecutive_days,
        MIN(date_value) AS leave_start_date,
        MAX(date_value) AS leave_end_date
    FROM consecutive_absences
    WHERE is_present = 0
    GROUP BY provider_id, attendance_group
    HAVING COUNT(*) >= 2  -- Only sequences of 2+ consecutive absences
),

-- Flag providers with consecutive leaves
providers_with_consecutive_leaves AS (
    SELECT DISTINCT
        provider_id,
        MAX(consecutive_days) AS max_consecutive_leaves,
        LISTAGG(DISTINCT TO_CHAR(leave_start_date, 'MM/DD/YY') || ' to ' || TO_CHAR(leave_end_date, 'MM/DD/YY'), '; ') 
            WITHIN GROUP (ORDER BY leave_start_date) AS leave_periods
    FROM consecutive_leave_counts
    GROUP BY provider_id
),

-- Original provider_attendance CTE for backward compatibility
provider_attendance AS (
    SELECT 
        p.provider_id,
        COUNT(DISTINCT DATE(p.date)) AS L7_WD,
        MAX(CASE WHEN DATE(p.date) = CURRENT_DATE - 7 THEN 1 ELSE 0 END) AS D7_present,
        MAX(CASE WHEN DATE(p.date) = CURRENT_DATE - 1 THEN 1 ELSE 0 END) AS D1_present,
        MAX(CASE WHEN DATE(p.date) = CURRENT_DATE - 2 THEN 1 ELSE 0 END) AS D2_present,
        MAX(CASE WHEN DATE(p.date) = CURRENT_DATE - 3 THEN 1 ELSE 0 END) AS D3_present,
        MAX(CASE WHEN DATE(p.date) = CURRENT_DATE THEN 1 ELSE 0 END) AS D0_present
    FROM providerxdate__active_profile__hourly__facts p
    JOIN base b ON p.provider_id = b.provider_id
    WHERE DATE(p.date) BETWEEN CURRENT_DATE - 7 AND CURRENT_DATE
      AND UPPER(p.ischeckedin::text) IN ('1','TRUE','YES')
    GROUP BY p.provider_id
),

cm AS (
    SELECT DISTINCT 
        b.provider_id,
        CASE 
            WHEN COALESCE(SUM(acm.marked_working), 0) >= 4 
            THEN 'Active' 
            ELSE 'Inactive' 
        END AS L7_active
    FROM base b 
    LEFT JOIN (
        SELECT 
            PROVIDER_ID, 
            DATE(date) AS date,
            COUNT(CASE WHEN status = 'marked working' THEN 1 END) AS marked_working 
        FROM PUBLIC.providerXdateXhour__calendar_marking__hourly__facts 
        WHERE DATE(date) BETWEEN CURRENT_DATE - 7 AND CURRENT_DATE - 1
          AND START_HOUR_LOCAL BETWEEN 7 AND 19
        GROUP BY PROVIDER_ID, DATE(date)
    ) acm ON acm.provider_id = b.provider_id
    GROUP BY b.provider_id
),

seven_am_partners AS (
    SELECT DISTINCT provider_id
    FROM PUBLIC.providerXdateXhour__calendar_marking__hourly__facts
    WHERE status = 'marked working'
      AND start_hour_local = 7
      AND DATE(date) BETWEEN CURRENT_DATE - 1 AND CURRENT_DATE
),

daily_hours_next7 AS (
    SELECT
        provider_id,
        DATE(date) AS work_date,
        COUNT(CASE WHEN status = 'marked working' THEN 1 END) AS daily_working_hours
    FROM PUBLIC.providerXdateXhour__calendar_marking__hourly__facts
    WHERE DATE(date) BETWEEN CURRENT_DATE + 1 AND CURRENT_DATE + 7
      AND start_hour_local BETWEEN 7 AND 19
    GROUP BY provider_id, DATE(date)
),

provider_type AS (
    SELECT
        provider_id,
        MAX(CASE WHEN daily_working_hours > 4 AND daily_working_hours < 7 THEN 1 ELSE 0 END) AS is_part_time_flag
    FROM daily_hours_next7
    GROUP BY provider_id
)

SELECT DISTINCT
    b.provider_id AS "PROVIDER_ID",
    b.provider_name AS "PROVIDER_NAME",
    b.age_days AS "AGE DAYS",
    COALESCE(tb.temporary_block, 'No') AS "TEMP BLOCK",
    CASE WHEN tb.temp_block_date IS NOT NULL THEN TO_CHAR(tb.temp_block_date, 'MM/DD/YY') ELSE NULL END AS "TEMP BLOCK DATE", 
    tb.temp_block_reason AS "TEMP BLOCK REASON",
    TRIM(REPLACE(REPLACE(REPLACE(sh.HUB_NAME, CHR(10), ''), CHR(13), ''), ' ', '')) AS "HUB_NAME",
    COALESCE(pa.L7_WD, 0) AS "L7 WD",
    COALESCE(pa.D7_present, 0) AS "D-7 present",
    COALESCE(pa.D1_present, 0) AS "D-1 present",
    COALESCE(pa.D2_present, 0) AS "D-2 present",
    COALESCE(pa.D3_present, 0) AS "D-3 present",
    COALESCE(pa.D0_present, 0) AS "D0 present",
    -- New enhanced consecutive leave detection
    CASE WHEN pcl.provider_id IS NOT NULL THEN 'Yes' ELSE 'No' END AS "Has_Consecutive_Leave_2plus",
    COALESCE(pcl.max_consecutive_leaves, 0) AS "Max_Consecutive_Leave_Days",
    pcl.leave_periods AS "Leave_Periods",
    cm.L7_active AS "L7 active",
    CASE 
        WHEN sap.provider_id IS NOT NULL AND COALESCE(pt.is_part_time_flag, 0) = 1 THEN '7AM PT'
        WHEN sap.provider_id IS NOT NULL THEN '7AM FT'
        WHEN COALESCE(pt.is_part_time_flag, 0) = 1 THEN '8AM PT'
        ELSE '8AM FT'
    END AS "TYPE"
FROM base b
LEFT JOIN hubs h ON b.provider_id = h.provider_id
LEFT JOIN smart_hubs_view sh ON sh.HUB_ID = h.primary_hub_id
LEFT JOIN provider_attendance pa ON pa.provider_id = b.provider_id
LEFT JOIN cm ON cm.provider_id = b.provider_id
LEFT JOIN seven_am_partners sap ON sap.provider_id = b.provider_id
LEFT JOIN provider_type pt ON pt.provider_id = b.provider_id
LEFT JOIN temp_block tb ON tb.provider_id = b.provider_id
LEFT JOIN providers_with_consecutive_leaves pcl ON pcl.provider_id = b.provider_id
WHERE cm.L7_active = 'Active'
  AND pcl.provider_id IS NOT NULL  -- Only show providers with consecutive leaves of 2+ days
  AND b.age_days != 0
  AND TRIM(REPLACE(REPLACE(REPLACE(sh.HUB_NAME, CHR(10), ''), CHR(13), ''), ' ', '')) LIKE '%insta_maids%'
ORDER BY b.provider_id;
